# Copy to .env and adjust:   cp .env.example .env
# Relative paths are resolved against the project folder.

# ---------- Chat LLM: LM Studio via LangChain ChatOpenAI ----------
# LM Studio: Developer tab -> Start Server. The /v1 suffix is required.
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=sk-lm-6Uttg01A:cNj0WFH7q5da5oceGSqI
# Model id as shown by LM Studio. Blank = first loaded chat model.
LLM_MODEL=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=180
# JSON-schema constrained decoding for the router. Set false if your model or
# LM Studio version rejects response_format (the router then uses a JSON prompt).
ROUTER_STRUCTURED_OUTPUT=true

# ---------- Embeddings ----------
# openai = LM Studio serves the embedding model at LLM_BASE_URL + /embeddings
#          (frees the ~2.2 GB an in-process bge-m3 would need next to the chat LLM;
#           the right choice on ~8 GB machines)
# huggingface = run the embedding model in-process with sentence-transformers
EMBEDDING_BACKEND=huggingface
EMBEDDING_MODEL=BAAI/bge-m3
# Only used when EMBEDDING_BACKEND=huggingface:
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
# HF_CACHE_DIR=D:/hf-cache

# ---------- Vector store: Qdrant ----------
# embedded = local folder, no install (one process only)
# server   = Docker (docker compose up -d qdrant) or Qdrant Cloud
QDRANT_MODE=embedded
QDRANT_PATH=storage/qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=thesis_docs

# ---------- Structured data ----------
# sqlite = text-to-SQL, zero install, most reliable with 7B models
# neo4j  = text-to-Cypher (docker compose up -d neo4j; needs APOC)
GRAPH_BACKEND=sqlite
SQLITE_PATH=storage/graph.db
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
NEO4J_DATABASE=neo4j
# For CSV columns not following the <table>_id convention (JSON):
# FK_OVERRIDES={"proyek.penanggung_jawab_id": "pegawai"}

# ---------- Data ----------
DOCUMENTS_DIR=data/documents
TABLES_DIR=data/tables

# ---------- Retrieval ----------
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
RETRIEVAL_CANDIDATES=20
BM25_WEIGHT=0.5
RRF_C=60

# ---------- Text-to-query ----------
GRAPH_MAX_ATTEMPTS=3
GRAPH_ROW_LIMIT=50

# ---------- API ----------
# Set to protect /admin/* (send as X-Admin-Key header)
ADMIN_API_KEY=
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=
MAX_HISTORY_TURNS=6
